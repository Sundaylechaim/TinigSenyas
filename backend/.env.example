# Copy this file to backend/.env and replace every placeholder before use.
# Never commit backend/.env or paste production secrets into source control.

# Required for authenticated remote mobile TTS requests.
TTS_API_TOKEN=replace-with-a-long-random-secret
TTS_ALLOWED_ORIGINS=

# Comma-separated origins for a hosted web frontend; localhost is always allowed.
APP_ALLOWED_ORIGINS=

# Required only if administrative vocabulary/DMCA endpoints should be enabled.
ADMIN_API_TOKEN=replace-with-a-different-long-random-secret

# OTA model and label URLs, SHA-256 hashes, versions, and the vocabulary DB path
# use the defaults documented in backend/README.md. Set overrides only when
# deploying a different model bundle or mounting a persistent database.

# Optional Azure Speech fallback. Edge-TTS is used when either value is absent.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Email footer configuration. The code has defaults; set the real production URL
# and organization's mailing address before enabling outbound email.
APP_BASE_URL=https://tinigsenyas.org

# TensorFlow startup/logging options.
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=3
